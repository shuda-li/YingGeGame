  "core_gameplay": {
    "design_intent": "跑酷与战斗不是两种玩法，而是同一套动作语言的两个面向。跑酷态与战斗态共享位移参数，切换时不重置速度，玩家可以在高速运动中直接完成击杀，不需要停顿、不需要切换模式。",

    "pillars": [
      {
        "id": "P1",
        "name": "速度感",
        "definition": "移动本身即奖励，跑得快会被看见、被听见。",
        "design_actions": [
          "相机前瞻：视野随移速前移",
          "速度线、残影、屏幕边缘径向模糊，强度随移速线性增强",
          "BGM 随移速动态混音，速度越快鼓点越密"
        ]
      },
      {
        "id": "P2",
        "name": "流畅感",
        "definition": "输入零延迟，动作不断链，玩家不会因为一次操作卡住而死亡。",
        "design_actions": [
          "起跳缓冲 120ms 与土狼时间 100ms 提供操作宽容",
          "攻击后 40% 帧为取消窗口，允许提前衔接",
          "死亡后 3 秒内重开，重试成本极低"
        ]
      },
      {
        "id": "P3",
        "name": "掌控感",
        "definition": "易上手、难精通，技巧天花板由玩家自己定义。",
        "design_actions": [
          "新手靠基础动作即可通关",
          "高手通过路线选择与连招取消刷高评价",
          "评价与排行榜驱动重复挑战"
        ]
      }
    ],

    "core_loop": {
      "name": "跑、打、蓄、爆、结算",
      "duration_seconds": { "min": 90, "max": 150 },
      "steps": [
        { "order": 1, "name": "进入赛段", "description": "从起点出发，立即进入高速跑酷状态，无需热身" },
        { "order": 2, "name": "穿越与战斗", "description": "跑酷途中遭遇敌人，可绕行或击杀，战斗不打断跑酷节奏" },
        { "order": 3, "name": "蓄势", "description": "跑酷动作与连击共同积累势能，鼓励保持高速且不断连击" },
        { "order": 4, "name": "终结", "description": "势能满槽释放终结技，短暂无敌、范围清场并提升移速" },
        { "order": 5, "name": "结算", "description": "抵达终点，按用时、连击、收集三项评分，解锁星尘与内容" }
      ],
      "design_rules": [
        "死亡立即重开，单次重试成本不超过 3 秒",
        "战斗不强制停顿，可边跑边打",
        "绕行与击杀均可推进，但击杀额外获得势能，形成「战斗换取速度」的正向循环"
      ]
    },

    "action_system": {
      "state_model_note": "角色以有限状态机驱动，跑酷态与战斗态共用同一套位移参数，任意状态均可无缝转入攻击或受击。",
      "states": [
        { "id": "Idle", "name": "待机", "category": "跑酷" },
        { "id": "Run", "name": "奔跑", "category": "跑酷" },
        { "id": "Dash", "name": "冲刺", "category": "跑酷" },
        { "id": "Jump", "name": "起跳", "category": "跑酷" },
        { "id": "Air", "name": "滞空", "category": "跑酷" },
        { "id": "Land", "name": "落地", "category": "跑酷" },
        { "id": "Wall", "name": "墙滑", "category": "跑酷" },
        { "id": "Slide", "name": "滑铲", "category": "跑酷" },
        { "id": "AtkG", "name": "地面攻击", "category": "战斗" },
        { "id": "AtkA", "name": "空中攻击", "category": "战斗" },
        { "id": "Dive", "name": "下劈", "category": "战斗" },
        { "id": "Hurt", "name": "受击", "category": "状态" },
        { "id": "Dead", "name": "死亡", "category": "状态" }
      ],
      "moves": [
        { "name": "跑", "input": "默认", "params": { "acceleration_per_s2": 30, "max_speed": 8 }, "role": "节奏基准" },
        { "name": "冲刺", "input": "冲刺键", "params": { "speed": 14, "cooldown_s": 0.25, "invincible_ms": 200 }, "role": "位移与闪避合一" },
        { "name": "跳跃", "input": "跳跃键", "params": { "variable_height": true }, "role": "越障与起手" },
        { "name": "二段跳", "input": "空中再按跳", "params": { "reset_on_land": true }, "role": "空中连击与越障" },
        { "name": "墙滑", "input": "贴墙", "params": { "slide_deceleration": true }, "role": "垂直地形处理" },
        { "name": "墙跳", "input": "墙滑中按跳", "params": { "reverse_thrust": true }, "role": "垂直地形推进" },
        { "name": "滑铲", "input": "下 + 攻击", "params": { "low_profile": true, "cancel_to_attack": true }, "role": "穿越低矮障碍" },
        { "name": "下劈", "input": "空中下 + 攻击", "params": { "fast_fall": true, "aoe_on_land": true, "break_wall": true }, "role": "突进与破墙" }
      ]
    },

    "combat_system": {
      "combo": {
        "ground": { "stages": 3, "finisher_effect": "末段击退" },
        "air": { "stages": 2, "follow_up": "可接下劈落地" }
      },
      "cancel_window": { "position": "动作后 40% 帧", "purpose": "允许玩家提前取消并衔接下一段，把操作上限交给玩家" },
      "hit_count": { "increment_per_hit": 1, "reset_after_seconds": 2, "purpose": "鼓励持续进攻，避免站桩" },
      "invincibility": { "dash_ms": 200 },
      "hitstop_ms": { "min": 40, "max": 80 },
      "design_rules": [
        "战斗动作与跑酷动作共用位移，攻击时不锁死移动",
        "连招可在地面与空中互相衔接，形成连续高光",
        "所有攻击均可在冲刺中发动，保证「边跑边打」成立"
      ]
    },

    "momentum_system": {
      "gauge_max": 100,
      "gain_sources": [
        { "source": "跑酷动作", "examples": ["冲刺", "墙跳", "下劈", "连续穿越"], "note": "奖励高风险位移" },
        { "source": "连击", "examples": ["每次命中", "连击数加成"], "note": "奖励持续进攻" }
      ],
      "finisher": {
        "trigger": "势能满槽",
        "damage": 200,
        "effects": ["短暂无敌", "范围清场", "移速提升"],
        "design_intent": "奖励「持续高速且不断连击」的玩家，让激进打法获得正反馈"
      }
    },

    "game_feel_parameters": [
      { "name": "起跳缓冲", "target": 120, "unit": "ms", "note": "落地前按跳，落地后自动起跳" },
      { "name": "土狼时间", "target": 100, "unit": "ms", "note": "离开平台后仍可起跳的宽容窗口" },
      { "name": "攻击取消窗口", "target": 40, "unit": "% 动作帧", "note": "位于动作后段" },
      { "name": "冲刺无敌帧", "target": 200, "unit": "ms", "note": "闪避期间免疫伤害" },
      { "name": "命中停顿", "target": { "min": 40, "max": 80 }, "unit": "ms", "note": "命中瞬间定格，强化打击感" },
      { "name": "相机前瞻", "target": 0.35, "unit": "屏幕宽度倍率", "note": "乘以当前速度，跑得越快视野越靠前" },
      { "name": "最大移速", "target": 8, "unit": "单位/秒", "note": "冲刺时提升至 14" }
    ],

    "feedback_layers": {
      "visual": ["速度线", "残影", "屏幕边缘径向模糊（随移速增强）", "终结技全屏闪白与色差"],
      "audio": ["跑酷脚步与 BGM 同拍", "命中音落在强拍", "终结技独立音色"],
