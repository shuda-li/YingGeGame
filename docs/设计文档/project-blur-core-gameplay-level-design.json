  "level_design": {
    "design_intent": "关卡以「赛段」为最小单位，通过赛段类型与难度曲线的组合控制节奏。难度曲线始终略高于玩家能力曲线，形成一条可以持续停留的心流通道。",

    "structure": {
      "segments_per_level": { "min": 3, "max": 5 },
      "level_duration_minutes": { "min": 2, "max": 4 },
      "checkpoints": "每 1–2 个赛段设置一个检查点",
      "restart_cost_seconds": 3,
      "composition_rule": "每关开头为低风险热身赛段，结尾为高光赛段，中段承担教学与压力"
    },

    "segment_types": [
      {
