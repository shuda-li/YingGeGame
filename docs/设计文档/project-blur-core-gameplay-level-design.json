{
  "document": {
    "title": "《疾影》核心玩法与关卡设计文档",
    "project": "疾影 / Project Blur",
    "version": "v0.1",
    "date": "2026-10-11",
    "genre": "2D 横版跑酷动作",
    "platforms": ["PC", "iOS", "Android"],
    "scope": ["核心玩法", "关卡设计"],
    "related_document": "横版跑酷动作游戏策划案 v0.1",
    "confidentiality": "内部",
    "note": "本文件所有数值均为设计目标与初始假设，需经原型测试验证后迭代。"
